{
 "opener": 7.57,
 "total": 130.07,
 "beats": [
  {
   "id": "A",
   "start": 7.57,
   "dur": 9.0,
   "caps": [
    {
     "id": "a1",
     "a": 0.5,
     "b": 2.38,
     "text": "This is the owner's page."
    },
    {
     "id": "a1",
     "a": 2.18,
     "b": 4.12,
     "text": "A listing score of fifty."
    },
    {
     "id": "a2",
     "a": 4.6,
     "b": 6.84,
     "text": "Four things to fix before Christmas."
    }
   ]
  },
  {
   "id": "B",
   "start": 16.57,
   "dur": 8.5,
   "caps": [
    {
     "id": "b1",
     "a": 0.5,
     "b": 2.51,
     "text": "Each one is a suggestion."
    },
    {
     "id": "b1",
     "a": 2.31,
     "b": 5.26,
     "text": "Accept, suggest a change, or discard."
    },
    {
     "id": "b1",
     "a": 5.06,
     "b": 6.63,
     "text": "The owner decides."
    }
   ]
  },
  {
   "id": "C",
   "start": 25.07,
   "dur": 28.0,
   "caps": [
    {
     "id": "c1",
     "a": 0.3,
     "b": 3.37,
     "text": "Accept on Christmas Eve, and Kaiku takes over."
    },
    {
     "id": "c2",
     "a": 3.9,
     "b": 5.77,
     "text": "It asks one plain question."
    },
    {
     "id": "c3",
     "a": 8.8,
     "b": 10.38,
     "text": "The owner says yes."
    },
    {
     "id": "c4",
     "a": 11.1,
     "b": 11.69,
     "text": "Saved."
    },
    {
     "id": "c4",
     "a": 11.49,
     "b": 16.26,
     "text": "The score goes to sixty, and the new hours show under On Fonecta now."
    },
    {
     "id": "c5",
     "a": 16.6,
     "b": 18.06,
     "text": "Then Kaiku remembers."
    },
    {
     "id": "c5",
     "a": 17.86,
     "b": 19.97,
     "text": "You changed this last year too."
    },
    {
     "id": "c5",
     "a": 19.77,
     "b": 21.11,
     "text": "Make it recurring?"
    },
    {
     "id": "c6",
     "a": 21.6,
     "b": 22.9,
     "text": "Yes, every year."
    },
    {
     "id": "c6",
     "a": 22.7,
     "b": 23.32,
     "text": "Done."
    }
   ]
  },
  {
   "id": "D",
   "start": 53.07,
   "dur": 13.5,
   "caps": [
    {
     "id": "d1",
     "a": 0.4,
     "b": 1.8,
     "text": "Next, the typo."
    },
    {
     "id": "d1",
     "a": 1.6,
     "b": 4.6,
     "text": "Kaiku asks, and one word fixes it."
    },
    {
     "id": "d2",
     "a": 5.0,
     "b": 7.52,
     "text": "A three star review has no reply."
    },
    {
     "id": "d2",
     "a": 7.32,
     "b": 8.79,
     "text": "Kaiku drafts one."
    },
    {
     "id": "d2",
     "a": 8.59,
     "b": 10.76,
     "text": "Say yes, and it is handled."
    }
   ]
  },
  {
   "id": "P",
   "start": 66.57,
   "dur": 10.0,
   "caps": [
    {
     "id": "p1",
     "a": 0.5,
     "b": 2.29,
     "text": "The same page fits a phone."
    },
    {
     "id": "p1",
     "a": 2.09,
     "b": 4.41,
     "text": "The owner can decide from anywhere."
    },
    {
     "id": "p2",
     "a": 5.0,
     "b": 6.53,
     "text": "Nothing to install."
    }
   ]
  },
  {
   "id": "E",
   "start": 76.57,
   "dur": 17.0,
   "caps": [
    {
     "id": "e1",
     "a": 0.4,
     "b": 2.92,
     "text": "And the owner never has to log in."
    },
    {
     "id": "e1",
     "a": 2.72,
     "b": 4.07,
     "text": "First, an email."
    },
    {
     "id": "e2",
     "a": 4.6,
     "b": 5.38,
     "text": "No reply?"
    },
    {
     "id": "e2",
     "a": 5.18,
     "b": 6.65,
     "text": "A WhatsApp message."
    },
    {
     "id": "e3",
     "a": 7.4,
     "b": 8.48,
     "text": "Still nothing?"
    },
    {
     "id": "e3",
     "a": 8.28,
     "b": 9.3,
     "text": "Kaiku calls."
    },
    {
     "id": "e3",
     "a": 9.1,
     "b": 12.56,
     "text": "These are the real messages, with their real times."
    }
   ]
  },
  {
   "id": "F",
   "start": 93.57,
   "dur": 18.5,
   "caps": [
    {
     "id": "f1",
     "a": 0.5,
     "b": 3.31,
     "text": "Kaiku also knows when to stay quiet."
    },
    {
     "id": "f1",
     "a": 3.11,
     "b": 5.41,
     "text": "Father's Day is this Sunday."
    },
    {
     "id": "f1",
     "a": 5.21,
     "b": 10.11,
     "text": "The clinic is closed on Sundays, and it is not a public holiday."
    },
    {
     "id": "f1",
     "a": 9.91,
     "b": 13.37,
     "text": "So the answer is no change, with the reason."
    },
    {
     "id": "f2",
     "a": 13.8,
     "b": 17.45,
     "text": "Independence Day on 6 December is a Sunday too."
    },
    {
     "id": "f2",
     "a": 17.25,
     "b": 18.62,
     "text": "Also no change."
    }
   ]
  },
  {
   "id": "G",
   "start": 112.07,
   "dur": 10.5,
   "caps": [
    {
     "id": "g1",
     "a": 0.4,
     "b": 3.13,
     "text": "Under it all runs an Orion-LD broker."
    },
    {
     "id": "g1",
     "a": 2.93,
     "b": 5.53,
     "text": "Every source is its own datasetId,"
    },
    {
     "id": "g1",
     "a": 5.33,
     "b": 8.67,
     "text": "so every suggestion shows where it came from."
    }
   ]
  },
  {
   "id": "H",
   "start": 122.57,
   "dur": 7.5,
   "caps": [
    {
     "id": "h1",
     "a": 0.6,
     "b": 1.84,
     "text": "Connect suggests."
    },
    {
     "id": "h1",
     "a": 1.64,
     "b": 3.26,
     "text": "The customer approves."
    }
   ]
  }
 ],
