[Unit]
Description=Kaiku Aura feeder (Foli, AIS, weather into Orion-LD)
After=network-online.target docker.service

[Service]
WorkingDirectory=/root/hack/kaiku
EnvironmentFile=/root/hack/kaiku/.env
ExecStart=/usr/bin/python3 -m kaiku.aura.feeder
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
